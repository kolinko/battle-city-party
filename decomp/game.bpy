    value2 = ram[0xd565 + slot]
    return value2

def encode_fire_input_modifiers(fire_buttons=a):
    at(0xfe48)
    push(fire_buttons)
    upgrade_selector = ram[0x013d]
    if upgrade_selector == 0x5a:
        at(0xfe5a)
        upgraded_buttons = pull()
        modifier = PROJECTILE_SECOND_MOVE
        if upgraded_buttons >= 2:
            at(0xfe61)
            modifier = PROJECTILE_SECOND_MOVE_AND_CLEAR_CELL
        at(0xfe63)
        return_values(y=modifier)
    at(0xfe50)
    plain_buttons = pull()
    modifier = PROJECTILE_SECOND_MOVE
    if plain_buttons >= 2:
        at(0xfe57)
        modifier = PROJECTILE_SECOND_MOVE
    at(0xfe59)
    return_values(y=modifier)

def merge_pad_bits_into_tank_flags(slot=x):
    at(0xff65)
    held = pad_current[slot]
    if held & 3:
        at(0xff6b)
        call(encode_fire_input_modifiers, a=held & 3)
        modifier = y
        at(0xff6e)
        modifier = y
        ram[scratch] = modifier
        impact = bullet_impact[slot]
        scratch_value = ram[scratch]
        bullet_impact[slot] = impact | scratch_value
    at(0xff7b)
    return


