def dispatch_tank_state(tank_slot=x):
    at(0xfe11)
    call(tank_state_dispatch, x=tank_slot)
    at(0xfe14)
    return

def allows_secondary_projectile(slot=x):
    at(0xfe1f)
    selector = ram[0x013e]
    if selector != SELECTOR_ENABLED:
        at(0xfe27)
        attributes = tank_attributes[slot]
        eligible = (attributes & SECONDARY_SHOT_MASK) == SECONDARY_SHOT_CLASS
        return_values(zero=eligible)
    at(0xfe26)
    return_values(zero=1)

def select_table_byte_by_state_flags(slot=x):
    at(0xfe2e)
    value = ram[0x013e]
    if value == 0x5a:
        at(0xfe39)
        value3 = ram[0x013d]
