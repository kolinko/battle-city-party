    adjusted: int = value
    at(0xdd6e)
    proposed_x = ram[work_x]
    if value >= proposed_x:
        at(0xdd72)
        set_carry()
        unwrapped = value - 1
        adjusted = ((value - 1) & 0xff)
    at(0xdd75)
    return adjusted

def pull_probe_inside_tank_y(value=a):
    adjusted: int = value
    at(0xdd76)
    proposed_y = ram[work_y]
    if value >= proposed_y:
        at(0xdd7a)
        set_carry()
        unwrapped = value - 1
        adjusted = ((value - 1) & 0xff)
    at(0xdd7d)
    return adjusted

